APP_NAME="Envios OK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://enviosokb2b.test

# ZIGO Payments / Mercado Pago (seller OAuth; never commit real secrets)
ZIGO_MP_ENABLED=false
ZIGO_MP_ENVIRONMENT=sandbox
ZIGO_MP_CLIENT_ID=
ZIGO_MP_CLIENT_SECRET=
ZIGO_MP_REDIRECT_URI=
ZIGO_MP_WEBHOOK_SECRET=
ZIGO_MP_WEBHOOK_URL=
ZIGO_MP_OAUTH_CACHE_STORE=file
ZIGO_MP_MARKETPLACE_FEE_ENABLED=false
ZIGO_MP_MARKETPLACE_FEE_AMOUNT=0.00
ZIGO_MP_PLATFORM_ENABLED=false
ZIGO_MP_PLATFORM_ACCESS_TOKEN=
ZIGO_MP_PLATFORM_ACCOUNT_ID=
ZIGO_MP_PLATFORM_WEBHOOK_SECRET=
ZIGO_MP_PLATFORM_WEBHOOK_URL=
ZIGO_SUPPORT_ATTACHMENT_DISK=local
ZIGO_SUPPORT_ATTACHMENT_MAX_KB=5120
ZIGO_API_ENABLED=false
ZIGO_API_HOST=api.zigo.local
ZIGO_API_URL=http://api.zigo.local
ZIGO_API_KEY_PREFIX=zg_stage
ZIGO_API_DEFAULT_MONTHLY_LIMIT=10000
ZIGO_API_DEFAULT_RATE_LIMIT=60
ZIGO_API_WEBHOOK_MAX_ATTEMPTS=6

ZIGO_DEVOPS_ENABLED=false
ZIGO_DEVOPS_MAX_PACKAGE_MB=25
ZIGO_DEVOPS_STAGE_PATH=
ZIGO_DEVOPS_PRODUCTION_PATH=
ZIGO_DEVOPS_ALLOW_PRODUCTION=false
ZIGO_ALLOW_UAT_COMMERCIAL_CONCEPT_RULES_IN_PRODUCTION=false
ZIGO_DEVOPS_XPERTA_STAGE_TESTER_ENABLED=false
ZIGO_DEVOPS_XPERTA_STAGE_BASE_URL=
ZIGO_DEVOPS_XPERTA_STAGE_CORPORATIVO=
ZIGO_DEVOPS_XPERTA_STAGE_LTD=estafeta
ZIGO_DEVOPS_XPERTA_STAGE_EMAIL=
ZIGO_DEVOPS_XPERTA_STAGE_PASSWORD=
ZIGO_DEVOPS_XPERTA_STAGE_API_KEY=
ZIGO_DEVOPS_XPERTA_STAGE_TOKEN_MINUTES=720
ZIGO_DEVOPS_XPERTA_STAGE_CONNECT_TIMEOUT=5
ZIGO_DEVOPS_XPERTA_STAGE_TIMEOUT=20
ZIGO_DEVOPS_XPERTA_STAGE_TOKEN_PATH=/api/v1/{corporativo}/login
ZIGO_DEVOPS_XPERTA_STAGE_FREQUENCY_PATH=/api/v1/empresas/{corporativo}/ltds/{ltd}/frecuencia/{origin}/{destination}
ZIGO_DEVOPS_XPERTA_STAGE_QUOTE_PATH=/api/v1/empresas/{corporativo}/ltds/{ltd}/servicios/{service}/cotizaciones
ZIGO_DEVOPS_XPERTA_STAGE_SERVICES=terrestre,diasig
ZIGO_DEVOPS_PHP_BINARY=
ZIGO_DEVOPS_HOST=devops.zigo.local
ZIGO_DEVOPS_URL=http://devops.zigo.local:8000

# ZIGO portal domains (full base URLs)
ZIGO_B2C_URL=https://zigo-envios.com
ZIGO_B2B_URL=https://empresas.zigo-envios.com
ZIGO_CRM_URL=https://crm.zigo-envios.com
ZIGO_SUPPORT_URL=https://soporte.zigo-envios.com
ZIGO_API_URL=https://api.zigo-envios.com
# Keep disabled until routes are explicitly restricted by host.
ZIGO_SUBDOMAIN_ROUTING_ENABLED=false
ZIGO_TRUSTED_HOSTS=
ZIGO_TRUSTED_BASE_DOMAINS=zigo-envios.com
ZIGO_CSP_REPORT_ONLY=true
ZIGO_EVIDENCE_ORPHAN_HOURS=48
ZIGO_NETWORK_HOST=network.zigo.local
ZIGO_NETWORK_URL=http://network.zigo.local:8000
ZIGO_PAYMENTS_HOST=payments.zigo.local
ZIGO_PAYMENTS_URL=http://payments.zigo.local:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=enviosokb2b
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mail.zigo-envios.com
MAIL_PORT=465
MAIL_USERNAME="seguridad@zigo-envios.com"
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="seguridad@zigo-envios.com"
MAIL_FROM_NAME="Seguridad ZIGO"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
B2C_UNVERIFIED_GUIDE_LIMIT=2
B2C_IDENTITY_PAYMENT_RESERVATION_MINUTES=30
B2C_IDENTITY_PAYMENT_RESERVATION_HOURS=24

ZIGO_B2C_BASE_RATE_SOURCE=provider
ZIGO_CONTRACT_FALLBACK_TO_PROVIDER=true
XPERTA_QUOTE_METHOD=POST
XPERTA_FREQUENCY_METHOD=POST
XPERTA_TOKEN_PATH=/api/v1/{corporativo}/login
XPERTA_FREQUENCY_PATH=/api/v1/empresas/{corporativo}/ltds/{ltd}/frecuencia/{origin}/{destination}
XPERTA_QUOTE_PATH=/api/v1/empresas/{corporativo}/ltds/{ltd}/servicios/{service}/cotizaciones
XPERTA_SEND_API_KEY_ON_OPERATIONS=true
XPERTA_GUIDE_ENABLED=true
XPERTA_GUIDE_PATH=/api/v1/empresas/{empresa}/ltds/{ltd}/servicios/{service}/guia
XPERTA_GUIDE_EMPRESA_ID=
XPERTA_GUIDE_PDF_ACCEPTS_TRACKING=false
ZIGO_PROVIDER_RATE_ENGINE_V2_ENABLED=false
ZIGO_PROVIDER_RATE_FALLBACK_TO_LEGACY=true
ZIGO_PROVIDER_RATE_ALLOW_XPERTA_B2C=false

# Estafeta consolidated gateway (never commit real credentials)
ZIGO_ESTAFETA_ENABLED=false
ZIGO_ESTAFETA_ENVIRONMENT=stage
ZIGO_ESTAFETA_BASE_URL=
ZIGO_ESTAFETA_AUTH_URL=
ZIGO_ESTAFETA_QUOTE_URL=
ZIGO_ESTAFETA_COVERAGE_URL=
ZIGO_ESTAFETA_SHIPMENT_URL=
ZIGO_ESTAFETA_TRACKING_URL=
ZIGO_ESTAFETA_CANCELLATION_URL=
ZIGO_ESTAFETA_USERNAME=
ZIGO_ESTAFETA_PASSWORD=
ZIGO_ESTAFETA_CUSTOMER_NUMBER=
ZIGO_ESTAFETA_CONTRACT_NUMBER=
ZIGO_ESTAFETA_API_KEY=
ZIGO_ESTAFETA_TIMEOUT=20
ZIGO_ESTAFETA_CONNECT_TIMEOUT=5
ZIGO_ESTAFETA_RETRY_TIMES=2
ZIGO_ESTAFETA_RETRY_SLEEP_MS=250
ZIGO_ESTAFETA_TOKEN_CACHE_SECONDS=3300
ZIGO_ESTAFETA_VERIFY_SSL=true
ZIGO_ESTAFETA_MOCK_ENABLED=false
ZIGO_ESTAFETA_LOG_CHANNEL=estafeta
ZIGO_ESTAFETA_LOG_RETENTION_DAYS=30
ZIGO_DEVOPS_ESTAFETA_PRD_ACTIVE_CHECKS=false
ZIGO_ESTAFETA_GATEWAY_ENABLED=false
ZIGO_ESTAFETA_FALLBACK_LEGACY=false
ZIGO_ESTAFETA_ENVIRONMENT=stage
ZIGO_ESTAFETA_AUTH_URL=
ZIGO_ESTAFETA_AUTH_PATH=oauth2/v2.0/token
ZIGO_ESTAFETA_CLIENT_ID=
ZIGO_ESTAFETA_CLIENT_SECRET=
ZIGO_ESTAFETA_SCOPE=https://graph.microsoft.com/.default
ZIGO_ESTAFETA_TOKEN_EXPIRY_SKEW_SECONDS=300
ZIGO_ESTAFETA_COVERAGE_CONTRACT=unknown
ZIGO_ESTAFETA_QUOTE_CONTRACT=unknown
ZIGO_SHIPPING_CONTRACT_RECORDER_ENABLED=false
ZIGO_SHIPPING_CONTRACT_RECORDER_ALLOW_PRODUCTION=false
ZIGO_B2C_UNIFIED_QUOTE_ENABLED=false
ZIGO_B2C_XPERTA_FULL_FLOW_ENABLED=false
