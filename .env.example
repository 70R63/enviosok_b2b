ZIGO_XPERTA_PRD_TOKEN_CHECK_ENABLED=false
ZIGO_CRM_ADMIN_NOTIFICATION_ENABLED=true
ZIGO_CRM_ADMIN_NOTIFICATION_EMAILS=
ZIGO_CRM_NOTIFY_INVOICE_REQUEST=true
ZIGO_CRM_NOTIFY_INCIDENT=true
ZIGO_CRM_NOTIFY_PROSPECT=true
ZIGO_CRM_GUIDES_EXPORT_LIMIT=25000
ZIGO_DRIVER_PRESENCE_TTL_MINUTES=5
ZIGO_DRIVER_HEARTBEAT_INTERVAL_SECONDS=30
# Central ZIGO Driver surface. Production is configured per environment; never hardcode it in routes.
ZIGO_DRIVER_HOST=driver.zigo.local
ZIGO_DRIVER_URL=http://driver.zigo.local:8000
